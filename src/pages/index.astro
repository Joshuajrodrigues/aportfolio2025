---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import { getCollection } from "astro:content";
import InteractiveBoard from "../components/react/InteractiveBoard.tsx";
export const prerender = true;

const [projects, art, blog] = await Promise.all([
    getCollection("project"),
    getCollection("art"),
    getCollection("blog"),
]);

const resolveSrc = (data: any): string => {
    if (typeof data.heroImage === "object" && data.heroImage !== null)
        return data.heroImage.src;
    if (typeof data.src === "object" && data.src !== null) return data.src.src;
    return data.heroImage || data.src || "";
};

// href = where a click goes (null = card isn't clickable)
const toItem = (entry: any, href: string | null) => ({
    id: entry.id,
    title: entry.data.title,
    src: resolveSrc(entry.data),
    accentColor: entry.data.colors?.[0] || "#1e1e1e",
    href,
});

const projectItems = projects.map((p) => toItem(p, `/projects/${p.id}`));
const artItems = art.map((a) => toItem(a, null));
const blogItems = blog.map((b) => toItem(b, `/blog/${b.id}`));
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    </head>
    <body>
        <Header />
        <main id="board">
            <div>
                <InteractiveBoard
                    client:load
                    projects={projectItems}
                    art={artItems}
                    blog={blogItems}
                    siteTitle={SITE_TITLE}
                />
            </div>
        </main>
        <Footer />
    </body>
</html>

<style>
    :root {
        --grid-color: #e5e5e5;
        --grid-size: 40px;
    }

    body {
        margin: 0;
        height: 100svh;
        width: 100svw;
        background-color: #ffffff;
        position: relative;
        overflow: hidden;
    }

    body::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        width: calc(100% + var(--grid-size));
        height: calc(100% + var(--grid-size));
        background-image:
            linear-gradient(var(--grid-color) 1px, transparent 1px),
            linear-gradient(90deg, var(--grid-color) 1px, transparent 1px);
        background-size: var(--grid-size) var(--grid-size);
        animation: panGrid 15s linear infinite;
        will-change: transform;
        z-index: -2;
    }

    body::after {
        content: "";
        position: absolute;
        inset: 0;
        background: radial-gradient(
            ellipse at center,
            transparent 30%,
            #ffffff 90%
        );
        pointer-events: none;
        z-index: -1;
    }

    @keyframes panGrid {
        0% {
            transform: translate(0, 0);
        }
        100% {
            transform: translate(
                calc(-1 * var(--grid-size)),
                calc(-1 * var(--grid-size))
            );
        }
    }

    main {
        position: relative;
        width: 100%;
        height: 100%;
    }
</style>
