---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import { getCollection } from "astro:content";
import InteractiveBoard from "../components/react/InteractiveBoard.tsx";

const projects = await getCollection("project");

const boardData = projects.map((project) => ({
    id: project.id,
    title: project.data.title,
    body: project.body,
    src: project.data.src?.src,
    accentColor: project.data.accentColor || "#1e1e1e",
}));
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    </head>
    <body>
        <Header />
        <main id="board">
            <InteractiveBoard
                client:load
                projects={boardData}
                siteTitle={SITE_TITLE}
            />
        </main>
        <Footer />
    </body>
</html>

<style>
    :root {
        --grid-color: #e5e5e5;
        --grid-size: 40px;
    }

    body {
        margin: 0;
        height: 100svh;
        width: 100svw;
        background-color: #ffffff;
        position: relative;
        overflow: hidden;
    }

    body::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        width: calc(100% + var(--grid-size));
        height: calc(100% + var(--grid-size));
        background-image:
            linear-gradient(var(--grid-color) 1px, transparent 1px),
            linear-gradient(90deg, var(--grid-color) 1px, transparent 1px);
        background-size: var(--grid-size) var(--grid-size);
        animation: panGrid 15s linear infinite;
        will-change: transform;
        z-index: -2;
    }

    body::after {
        content: "";
        position: absolute;
        inset: 0;
        background: radial-gradient(
            ellipse at center,
            transparent 30%,
            #ffffff 90%
        );
        pointer-events: none;
        z-index: -1;
    }

    @keyframes panGrid {
        0% {
            transform: translate(0, 0);
        }
        100% {
            transform: translate(
                calc(-1 * var(--grid-size)),
                calc(-1 * var(--grid-size))
            );
        }
    }

    main {
        position: relative;
        width: 100%;
        height: 100%;
    }
</style>
