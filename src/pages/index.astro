---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import { getCollection } from "astro:content";
import InteractiveBoard from "../components/react/InteractiveBoard.tsx";

const projects = await getCollection("project");
const blogs = await getCollection("blog");
const art = await getCollection("art");

const boardData = [...projects].map((project) => ({
    id: project.id,
    title: project.data.title,
    body: project.body,
    src: project.data.src?.src,
}));
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    </head>
    <body>
        <Header />

        <main id="board">
            <section class="intro">
                <div class="center-text">
                    <h2>
                        Hello, <br />
                        I'm {SITE_TITLE}
                    </h2>
                    <p>UIUX / Product Designer | 5 years</p>
                </div>
            </section>
            <InteractiveBoard client:load projects={boardData} />
            <Footer />
        </main>
    </body>
</html>

<style>
    :root {
        --grid-color: #e5e5e5;
        --grid-size: 40px;
    }

    body {
        margin: 0;
        height: 100svh;
        width: 100svw;
        background-color: #ffffff;
        position: relative;
        overflow: hidden;
    }

    /* The moving grid */
    body::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        /* Oversize the grid slightly to allow for the transform translation */
        width: calc(100% + var(--grid-size));
        height: calc(100% + var(--grid-size));
        background-image:
            linear-gradient(var(--grid-color) 1px, transparent 1px),
            linear-gradient(90deg, var(--grid-color) 1px, transparent 1px);
        background-size: var(--grid-size) var(--grid-size);
        animation: panGrid 15s linear infinite;
        will-change: transform;
        z-index: -2;
    }

    /* The radial fade overlay */
    body::after {
        content: "";
        position: absolute;
        inset: 0;
        background: radial-gradient(
            ellipse at center,
            transparent 30%,
            #ffffff 90%
        );
        pointer-events: none;
        z-index: -1;
    }

    @keyframes panGrid {
        0% {
            transform: translate(0, 0);
        }
        100% {
            transform: translate(
                calc(-1 * var(--grid-size)),
                calc(-1 * var(--grid-size))
            );
        }
    }

    main {
        position: relative;
        width: 100%;

        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;

        .intro {
            max-width: 1200px;
        }
    }

    .center-text {
        text-align: center;
        pointer-events: none;
        z-index: 10;
        user-select: none;
    }

    .center-text h2 {
        font-size: 3.5rem;
        margin: 0;
        text-shadow:
            2px 2px 0 #fff,
            -2px -2px 0 #fff,
            2px -2px 0 #fff,
            -2px 2px 0 #fff;
    }

    .center-text p {
        font-size: 1.25rem;
        margin-top: 10px;
        color: #333;
    }
    h2,
    .pixel-text {
        font-family: "Pixelify Sans", sans-serif;
    }
</style>
