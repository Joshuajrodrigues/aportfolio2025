---
const year = new Date().getFullYear();
---

<footer class="site-footer">
    <div class="footer-left">
        <a href="mailto:work@akankshagajankar.com" class="email-link">
            work@akankshagajankar.com
        </a>
    </div>
    <div class="footer-right">
        <span>© {year} Akanksha Gajankar</span>
        <span class="dot">•</span>
        <span>All rights reserved</span>
    </div>
</footer>
<style>
    .site-footer {
        position: fixed;
        bottom: 0;
        left: 0;
        width: 100%;
        box-sizing: border-box;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 24px;
        background: rgba(255, 255, 255, 0.8);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        border-top: 1px solid rgba(0, 0, 0, 0.06);
        z-index: 90; /* Keeps it above canvas (20) and grid (15), below dock (100) */
        pointer-events: auto;
    }
    .email-link {
        color: #171717;
        text-decoration: none;
        border-bottom: 1px dashed #a3a3a3;
        transition:
            border-color 0.15s ease,
            color 0.15s ease;
    }
    .email-link:hover {
        color: #000;
        border-bottom-color: #000;
    }
    .footer-right {
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .dot {
        color: #d4d4d4;
    }
    @media (max-width: 640px) {
        .site-footer {
            flex-direction: column;
            gap: 10px;
            padding: 12px 20px 70px 20px; /* extra bottom padding for dock */
            text-align: center;
        }
        .footer-left {
            width: 100%;
        }
        .email-link {
            display: inline-block;
            font-size: 0.85rem;
            max-width: 100%;
            word-break: break-word;
        }
        .footer-right {
            flex-wrap: wrap;
            justify-content: center;
            row-gap: 4px;
            font-size: 0.72rem;
            gap: 6px;
        }
    }
    @media (max-width: 360px) {
        .footer-right span:not(.dot) {
            flex: 0 0 100%;
        }
        .dot {
            display: none;
        }
    }
</style>
