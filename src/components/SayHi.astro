---
import Modal from "./Modal.astro";
const socialLinks = {
  instagram: "https://instagram.com/yourprofile",
  linkedin: "https://linkedin.com/in/yourprofile",
  behance: "https://behance.net/yourprofile",
};
const email = "work@akankshgajankar.com";
---

<Modal id="contactModal">
  <span slot="open" id="cta">
    <slot />
  </span>
  <div slot="main">
    <h3>Contact Me</h3>
    <hr />
    <div class="email-row">
      <span id="modal-email">
        <a
          class="email-content-container"
          aria-label="contact info"
          href={`mailto:${email}`}
        >
          {email}
          <svg
            fill="#000000"
            xmlns="http://www.w3.org/2000/svg"
            width="16px"
            height="16px"
            viewBox="0 0 52 52"
            enable-background="new 0 0 52 52"
            xml:space="preserve"
          >
            <g>
              <path
                d="M48.7,2H29.6C28.8,2,28,2.5,28,3.3v3C28,7.1,28.7,8,29.6,8h7.9c0.9,0,1.4,1,0.7,1.6l-17,17   c-0.6,0.6-0.6,1.5,0,2.1l2.1,2.1c0.6,0.6,1.5,0.6,2.1,0l17-17c0.6-0.6,1.6-0.2,1.6,0.7v7.9c0,0.8,0.8,1.7,1.6,1.7h2.9   c0.8,0,1.5-0.9,1.5-1.7v-19C50,2.5,49.5,2,48.7,2z"
              ></path>
              <path
                d="M36.3,25.5L32.9,29c-0.6,0.6-0.9,1.3-0.9,2.1v11.4c0,0.8-0.7,1.5-1.5,1.5h-21C8.7,44,8,43.3,8,42.5v-21   C8,20.7,8.7,20,9.5,20H21c0.8,0,1.6-0.3,2.1-0.9l3.4-3.4c0.6-0.6,0.2-1.7-0.7-1.7H6c-2.2,0-4,1.8-4,4v28c0,2.2,1.8,4,4,4h28   c2.2,0,4-1.8,4-4V26.2C38,25.3,36.9,24.9,36.3,25.5z"
              ></path>
            </g>
          </svg>
        </a>
      </span>
    </div>
    <div class="social-buttons">
      <a
        class="instagram"
        href={socialLinks.instagram}
        target="_blank"
        aria-label="Instagram"
      >
        <!-- Instagram logo -->
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="currentColor"
        >
          <path
            d="M7 2C4.2 2 2 4.2 2 7v10c0 2.8 2.2 5 5 5h10c2.8 0 5-2.2 5-5V7c0-2.8-2.2-5-5-5H7zm10 2a3 3 0 0 1 3 3v10a3 3 0 0 1-3 3H7a3 3 0 0 1-3-3V7a3 3 0 0 1 3-3h10zm-5 3a5 5 0 1 0 0 10 5 5 0 0 0 0-10zm0 2a3 3 0 1 1 0 6 3 3 0 0 1 0-6zm4.5-3a1 1 0 1 1 0 2 1 1 0 0 1 0-2z"
          ></path>
        </svg>
      </a>
      <a
        href="/akanksha-gajankar-2025-resume.pdf"
        aria-label="download resume"
        download="akanksha-gajankar-2025-resume.pdf"
        role="button"
        aria-label="Resume"
      >
        <!-- LinkedIn logo -->
        <img src={"/site-icons/resume.svg"} alt={"resume"} />
      </a>
    </div>
  </div>
  <button class="close-modal" slot="close">Close</button>
</Modal>

<style>
  #cta {
    display: inline-block;
    background-color: #6faec9;
    border: 1px solid black;
    border-radius: 5px;
    color: black;
    padding: 6px 12px;
    box-shadow: 4px 4px black;
    font-size: 16px;
    cursor: pointer;
    transition:
      background-color 0.5s,
      color 0.5s;
  }
  #cta:hover {
    background-color: black;
    color: white;
  }

  .email-content-container {
    text-decoration: underline;
  }
  /* Modal backdrop */
  .modal-backdrop {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.6);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 900;
  }
  .modal-backdrop.hidden {
    display: none;
  }

  /* Modal box */

  .email-row {
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 12px 0;
  }

  #modal-email {
    margin-right: 8px;
    font-weight: bold;
    a {
      all: unset;
      cursor: pointer;
      text-decoration: underline black;
    }
  }
  .email-row button {
    background: none;
    border: none;
    cursor: pointer;
  }
  .social-buttons {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin-bottom: 16px;
  }
  .social-buttons a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 6px;
  }
  .social-buttons a.instagram {
    background: #e1306c;
    color: white;
  }
  .social-buttons a.linkedin {
    background: #0a66c2;
    color: white;
  }
  .social-buttons a.behance {
    background: #1769ff;
    color: white;
  }
  .social-buttons svg {
    width: 24px;
    height: 24px;
  }

  .close-modal {
    all: unset;
    background: #000;
    color: #fff;
    border: none;
    padding: 8px 16px;
    border-radius: 4px;
    cursor: pointer;
  }
  .close-modal:hover {
    opacity: 0.8;
  }
</style>
