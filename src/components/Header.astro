---
import HeaderLink from "./HeaderLink.astro";
import MenuButton from "./MenuButton.astro";
import { SITE_TITLE } from "../consts";
import CTAButton from "./CTAButton.astro";
import Resume from "./Resume.astro";
import SayHi from "./SayHi.astro";
const { headerColor } = Astro.props;
---

<header transition:persist>
    <nav>
        <h1>
            <a
                aria-label="Weather"
                class="mobile-header"
                href="/"
                id="weather-mobile"
            >
                Hello there...
            </a>
            <a class="desktop-header" href="/" id="weather-desktop">
                Hello there...
            </a>
        </h1>

        <div class="desktop-header internal-links">
            <Resume />
        </div>
        <div class="mobile-header menu">
            <Resume />
            <!-- <SayHi id="mobilemodal"> Say Hi </SayHi>
            <MenuButton /> -->
        </div>
    </nav>
    <div id="toast-holder"></div>
</header>
<script>
    type Weather = { icon: string; condition: string };

    const KEY = "goa-weather";
    const TTL = 30 * 60 * 1000; // 30 minutes
    const RETRY_AFTER = 5 * 60 * 1000; // wait 5 minutes after a failure

    let inFlight = false;
    let failedAt = 0;

    function toWeather(code: number): Weather {
        if (code > 0 && code <= 3) return { icon: "☁️", condition: "Cloudy" };
        if (code >= 45 && code <= 48) return { icon: "🌫️", condition: "Fog" };
        if ((code >= 51 && code <= 67) || (code >= 80 && code <= 82))
            return { icon: "🌧️", condition: "Rain" };
        if ((code >= 71 && code <= 77) || (code >= 85 && code <= 86))
            return { icon: "❄️", condition: "Snow" };
        if (code >= 95) return { icon: "⛈️", condition: "Storm" };
        return { icon: "☀️", condition: "Sunny" };
    }

    function readCache(): { weather: Weather; fresh: boolean } | null {
        try {
            const raw = localStorage.getItem(KEY);
            if (!raw) return null;
            const { weather, at } = JSON.parse(raw);
            return { weather, fresh: Date.now() - at < TTL };
        } catch {
            return null;
        }
    }

    function writeCache(weather: Weather) {
        try {
            localStorage.setItem(
                KEY,
                JSON.stringify({ weather, at: Date.now() }),
            );
        } catch {}
    }

    function render(desktop: string, mobile: string) {
        const d = document.getElementById("weather-desktop");
        const m = document.getElementById("weather-mobile");
        if (d) d.innerText = desktop;
        if (m) m.innerText = mobile;
    }

    function renderWeather(w: Weather) {
        render(`${w.icon} ${w.condition} in Goa`, w.icon);
    }

    async function fetchWeather() {
        inFlight = true;
        try {
            // Coordinates for Vasco da Gama, Goa
            const res = await fetch(
                "https://api.open-meteo.com/v1/forecast?latitude=15.3981&longitude=73.8111&current=weather_code",
            );
            const data = await res.json();
            const weather = toWeather(data.current.weather_code);
            writeCache(weather);
            renderWeather(weather);
        } catch (error) {
            console.error("Failed to fetch weather", error);
            failedAt = Date.now();
            // keep showing stale data if we have it
            const stale = readCache();
            if (stale) renderWeather(stale.weather);
            else render("Weather unavailable", "");
        } finally {
            inFlight = false;
        }
    }

    document.addEventListener("astro:page-load", () => {
        const cache = readCache();
        if (cache) renderWeather(cache.weather); // instant, no flash
        if (cache?.fresh) return; // no API call
        if (inFlight || Date.now() - failedAt < RETRY_AFTER) return;
        fetchWeather();
    });
</script>
<style>
    .visually-hidden {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
    }

    header {
        margin: 0;
        padding: 0 1em;
        background: transparent;
    }
    .border {
        padding: 0px 20px;
        border-bottom: 1px solid black;
    }
    h1 {
        margin: 0;
        font-size: clamp(1em, 1.25em, 1.5em);
    }

    h1 a,
    h1 a.active {
        text-decoration: none;
    }
    nav {
        display: flex !important;
        align-items: center;
        justify-content: space-between;
        margin: 0 15px;
    }
    nav a {
        padding: 1em 0.5em;
        transform: translateY(8px);
        color: var(--black);
        border-bottom: 4px solid transparent;
        text-decoration: none;
    }
    nav a.active {
        text-decoration: none;
        color: #d5673e;
    }
    .internal-links {
        display: flex;
        gap: 64px;
        font-weight: 400;
        line-height: 30px;
        font-size: clamp(0.5em, 1em, 1.25em);
    }
    .social-links,
    .social-links a {
        display: flex;
    }
    .mobile-header {
        /* visually hidden */
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
    }
    a.desktop-header {
        padding: 1em 0 !important;
    }
    .desktop-header {
        display: flex;

        gap: 18px;
        align-items: center;
    }
    @media (max-width: 720px) {
        .desktop-header {
            display: none;
        }
        nav {
            height: 50px;
        }
        .mobile-header {
            display: flex;
            gap: 18px;
            align-items: center;

            position: static;
            width: initial;
            height: initial;
            padding: initial;
            margin: initial;
            overflow: initial;
            clip: initial;
            white-space: initial;
            border: initial;
        }
    }
</style>
