---
import type { CollectionEntry } from "astro:content";
import type { MarkdownHeading } from "astro";
import BaseHead from "../components/BaseHead.astro";

import Footer from "../components/Footer.astro";

export const prerender = true;
type Props = CollectionEntry<"project">["data"] & {
    headings?: MarkdownHeading[];
};

const {
    title,
    type,
    description,
    tagline,
    contentBlocks,
    heroImage,
    navLabels = {},
    colors,
    heroHelpText,
    role,
    team,
    tags,
    impact,
    headings = [],
} = Astro.props;

const heroSrc =
    typeof heroImage === "object" && heroImage !== null
        ? heroImage.src
        : heroImage || "";
// Only H1s from the mdx content are used for the sticky nav.
// (Astro auto-generates a slug for every heading, which we use as the anchor id.)
const sections = headings
    .filter((h) => h.depth === 1)
    .map((h) => ({ ...h, label: navLabels[h.slug] ?? h.text }));

console.log("navLabels", navLabels);
---

<html lang="en">
    <head>
        <BaseHead title={title} description={description} image={heroSrc} />
    </head>

    <body class="site-container">
        <header class="work-header">
            <span class="work-header-crumb">
                {type} / {title}
            </span>
            <a href="/" class="back-link" data-back>
                <span>Back</span>
                <img
                    src="/site-icons/back2.svg"
                    alt=""
                    class="back-icon"
                    width="20"
                    height="20"
                    aria-hidden="true"
                />
            </a>
        </header>
        <main>
            <article>
                <section class="project-title--container">
                    <span class="project-eyebrow">{title}</span>
                    <h1 class="project-headline">{tagline}</h1>
                    <p class="project-description">{description}</p>
                    {tags && tags.length > 0 && (
                        <div class="tag-container">
                            {tags.map((tag: string, i: number) => (
                                <>
                                    <span>{tag}</span>
                                    {i < tags.length - 1 && (
                                        <span class="dot" aria-hidden="true">
                                            •
                                        </span>
                                    )}
                                </>
                            ))}
                        </div>
                    )}
                </section>

                <div class="hero-bleed">
                    {heroSrc && (
                        <img
                            src={heroSrc}
                            alt="hero"
                            loading="eager"
                            decoding="async"
                        />
                    )}
                </div>

                {sections.length > 0 && (
                    <nav class="section-nav" aria-label="Project sections">
                        <ul>
                            {sections.map((heading, index) => (
                                <li>
                                    <a
                                        href={`#${heading.slug}`}
                                        class="section-nav-link"
                                        data-slug={heading.slug}
                                    >
                                        <span class="section-nav-index">
                                            {String(index + 1).padStart(2, "0")}
                                            .
                                        </span>
                                        <span class="section-nav-label">
                                            {heading.label}
                                        </span>
                                    </a>
                                </li>
                            ))}
                        </ul>
                    </nav>
                )}

                <div class="centered-project-content">
                    {contentBlocks && contentBlocks?.length > 0 && (
                        <div class="content-container">
                            <div class="content m-w-700">
                                {contentBlocks?.[0]}
                            </div>
                            <div class="content m-w-700 text-right align-self-end">
                                {contentBlocks?.[0]}
                            </div>
                        </div>
                    )}
                    <slot />
                </div>
            </article>
        </main>
        <Footer />
    </body>
</html>

<script>
    function initBack() {
        document
            .querySelectorAll<HTMLAnchorElement>("[data-back]")
            .forEach((a) => {
                a.addEventListener("click", (e) => {
                    if (
                        history.length > 1 &&
                        document.referrer.startsWith(location.origin)
                    ) {
                        e.preventDefault();
                        history.back();
                    }
                });
            });
    }
    initBack();
    document.addEventListener("astro:page-load", initBack);
    function initSectionNav() {
        const links =
            document.querySelectorAll<HTMLAnchorElement>(".section-nav-link");
        const nav = document.querySelector<HTMLElement>(".section-nav");
        const navList = nav?.querySelector<HTMLElement>("ul");
        if (!links.length) return;

        const targets = Array.from(links)
            .map((link) => {
                const slug = link.dataset.slug;
                const el = slug ? document.getElementById(slug) : null;
                return el ? { link, el } : null;
            })
            .filter(
                (x): x is { link: HTMLAnchorElement; el: HTMLElement } =>
                    x !== null,
            );

        const isCompact = () => window.matchMedia("(max-width: 640px)").matches;

        function setActive(link: HTMLAnchorElement) {
            links.forEach((l) => l.classList.remove("active"));
            link.classList.add("active");

            // On the collapsed mobile layout, keep the expanded pill
            // centered in the scrollable strip instead of letting it
            // drift toward the edge as sections change.
            if (navList && isCompact()) {
                const containerRect = navList.getBoundingClientRect();
                const linkRect = link.getBoundingClientRect();
                const offset =
                    linkRect.left +
                    linkRect.width / 2 -
                    containerRect.left -
                    containerRect.width / 2;
                navList.scrollBy({ left: offset, behavior: "smooth" });
            }
        }

        links.forEach((link) => {
            link.addEventListener("click", (e) => {
                e.preventDefault();
                const slug = link.dataset.slug;
                const el = slug ? document.getElementById(slug) : null;
                if (!el) return;
                setActive(link);
                const offset = (nav?.offsetHeight ?? 0) + 16;
                const top =
                    el.getBoundingClientRect().top + window.scrollY - offset;
                window.scrollTo({ top, behavior: "smooth" });
            });
        });

        if (targets.length === 0) return;

        // Expand the first pill by default so mobile doesn't load as a
        // bare row of numbers before any scrolling happens.
        setActive(targets[0].link);

        const navHeight = nav?.offsetHeight ?? 60;
        const observer = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    const match = targets.find((t) => t.el === entry.target);
                    if (!match || !entry.isIntersecting) return;
                    setActive(match.link);
                });
            },
            { rootMargin: `-${navHeight + 8}px 0px -60% 0px`, threshold: 0 },
        );
        targets.forEach((t) => observer.observe(t.el));
    }

    initSectionNav();
    document.addEventListener("astro:page-load", initSectionNav);
</script>

<style>
    main {
        padding: 1em;
    }
    .work-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        /* Aligns horizontal padding directly with .project-title--container */
        padding: 16px 32px;
        border-bottom: 2px dashed rgba(0, 0, 0, 0.2);
        font-size: clamp(0.95rem, 1.8vw, 1.1rem);
    }

    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: inherit;
        text-decoration: none;
        line-height: 1;
    }

    .back-icon {
        width: 20px;
        height: 20px;
        display: inline-block;
    }

    /* ---------- Title block & spacing ---------- */
    .project-title--container {
        text-align: left;
        /* Clean margin structure aligned to layout gutters */
        margin: clamp(36px, 6vw, 64px) clamp(15px, 8vw, 70px)
            clamp(28px, 4vw, 44px);
        display: flex;
        flex-direction: column;
    }

    .project-eyebrow {
        font-size: clamp(calc((32 / 16) * 1rem), 2vw, 1.25rem);
        color: #1e1e1e;
        font-weight: 500;
        margin-bottom: clamp(12px, 2vw, 18px);
    }

    .project-headline {
        font-size: clamp(1.5rem, 7vw, 3.75rem);
        font-weight: bold;
        overflow-wrap: normal;
        word-break: normal;
        hyphens: manual;
        /* Increased line-height so pixel ascenders and descenders do not touch */
        line-height: 1.15;
        color: #1e1e1e;
        margin: 0 0 clamp(16px, 2.5vw, 24px) 0;
    }

    .project-description {
        font-family: "Source Code Pro", monospace;
        font-size: clamp(1rem, 2vw, 1.35rem);
        font-weight: normal;

        line-height: 1.55;
        color: #33272a;

        margin: 0 0 clamp(18px, 3vw, 28px) 0;
    }

    .tag-container {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 12px 10px;
        font-size: clamp(0.85rem, 1.6vw, 1rem);
        font-weight: 600;
        color: #594a4e;
        padding: 0;
        margin: 0;
    }

    .dot {
        opacity: 0.5;
        user-select: none;
    }

    @media (max-width: 480px) {
        .project-title--container {
            margin: 24px 15px 32px;
        }
    }
    /* ---------- Sticky section nav ---------- */
    .section-nav {
        position: sticky;
        top: 0;
        width: 100%;
        z-index: 10;
        background: rgba(255, 255, 255, 0.72);
        backdrop-filter: blur(20px) saturate(180%);
        -webkit-backdrop-filter: blur(20px) saturate(180%);
        border-bottom: 1px solid rgba(0, 0, 0, 0.15);
        box-shadow: 0 1px 0 rgba(0, 0, 0, 0.03);
    }
    @supports not (backdrop-filter: blur(1px)) {
        .section-nav {
            background: rgba(255, 255, 255, 0.95); /* solid fallback */
        }
    }
    .section-nav ul {
        display: flex;
        justify-content: space-between;
        align-items: center;
        list-style: none;
        margin: 0;
        /* Same horizontal padding as .centered-project-content's margin,
           so "Overview" and the last item line up with the body text edges. */
        padding: clamp(10px, 2vw, 14px) clamp(15px, 8vw, 70px);
        gap: clamp(14px, 4vw, 32px);
        overflow-x: auto;
        -ms-overflow-style: none;
        scrollbar-width: none;
    }
    .section-nav ul::-webkit-scrollbar {
        display: none;
    }
    .section-nav-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: clamp(4px, 1vw, 6px) clamp(8px, 2vw, 12px);
        border-radius: 999px;
        color: #33272a;
        text-decoration: none;
        font-size: clamp(11px, 1.8vw, 14px);
        font-weight: 600;
        white-space: nowrap;
        opacity: 0.55;
        transition:
            opacity 0.2s,
            background-color 0.2s;
    }
    .section-nav-link:hover,
    .section-nav-link.active {
        opacity: 1;
    }
    .section-nav-link.active {
        /*background: rgba(59, 124, 255, 0.12);*/
        color: #3b7cff;
    }
    .section-nav-label {
        display: inline-block;
        font-family: "Source Code Pro", monospace;
    }

    /* ---------- Mobile: collapsing "now reading" pills ---------- */
    @media (max-width: 640px) {
        .section-nav ul {
            justify-content: space-evenly;
            gap: 10px;
            padding: 10px clamp(15px, 6vw, 24px);
        }
        .section-nav-link {
            max-width: 34px;
            opacity: 0.8;
            background: rgba(51, 39, 42, 0.06);
            overflow: hidden;
            transition:
                max-width 0.4s cubic-bezier(0.65, 0, 0.35, 1),
                background-color 0.3s ease,
                opacity 0.3s ease;
        }
        .section-nav-link.active {
            max-width: 220px;
            opacity: 1;
            background: rgba(59, 124, 255, 0.14);
        }
        .section-nav-label {
            opacity: 0;
            max-width: 0;
            overflow: hidden;
            transition: opacity 0.25s ease 0.05s;
        }
        .section-nav-link.active .section-nav-label {
            opacity: 1;
            max-width: 200px;
        }
    }

    /* ---------- Role / Team / Impact grid ---------- */
    .rti {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        margin: clamp(24px, 6vw, 40px) 0;
        gap: clamp(20px, 4vw, 32px);
        color: #594a4e;
        h4 {
            font-weight: 700;
            color: #594a4e;
            font-size: clamp(1.25rem, 3vw, 32px);
        }
        p {
            font-size: clamp(1rem, 2vw, 24px);
        }
    }

    /* ---------- Content areas ---------- */
    .centered-project-content {
        margin: auto clamp(15px, 8vw, 70px);
    }
    .centered-project-content :global(p) {
        color: #1e1e1e;
        font-family: "Source Code Pro", monospace;
        font-size: clamp(24px, 2vw, 1rem);
        line-height: 30px;
    }
    .centered-project-content :global(h1) {
        color: #33272a;
        font-weight: 600;
        font-size: clamp(1.5rem, 5vw, 36px);
        margin-top: clamp(32px, 8vw, 58px);
    }
    .frame {
        border: 1px solid black;
        box-shadow: black -12px 12px;
        height: fit-content;
        border-radius: 12px;
        background-color: #fff;
        font-size: 0;
        line-height: 0;
        .title {
            line-height: 12px;
            max-height: 40px;
            border-bottom: 1px solid black;
            margin: 0px;
            font-size: 14px;
            display: flex;
            justify-content: space-between;
            padding: 10px 20px;
            .type {
                font-weight: 600;
            }
        }
        > img {
            border-bottom-left-radius: 12px;
            border-bottom-right-radius: 12px;
        }
    }

    /* ---------- Title + tags ---------- */
    .project-title--container {
        text-align: left;
        margin: clamp(32px, 8vw, 60px) clamp(15px, 6vw, 0px)
            clamp(24px, 6vw, 60px);
        h1 {
            font-weight: bold;
        }
        h3 {
            font-size: clamp(32px, 3vw, 28px);
            color: #1e1e1e;
            font-weight: normal;
        }
        h2 {
            font-size: clamp(32px, 3vw, 28px);
            font-weight: normal;
            font-family:
                "Source Code Pro", "Lucida Sans", "Lucida Sans Regular",
                "Lucida Grande", "Lucida Sans Unicode", Geneva, Verdana,
                sans-serif;
        }
    }
    .tag-container {
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-start;
        align-items: center;
        row-gap: 8px;
        font-size: clamp(24px, 2vw, 1rem);
        font-family:
            "Source Code Pro", "Lucida Sans", "Lucida Sans Regular",
            "Lucida Grande", "Lucida Sans Unicode", Geneva, Verdana, sans-serif;
    }

    .hero-image-help-text {
        margin: auto clamp(15px, 12vw, 180px);
        font-style: italic;
        font-size: clamp(0.75rem, 2vw, 20px);
        margin-top: clamp(16px, 4vw, 40px);
        color: #594a4e;
        opacity: 0.75;
        text-align: center;
    }
    main {
        width: calc(100% - 2em);
        max-width: 100%;
        margin: 0;
    }
    .carousel {
        margin-top: 64px;
    }
    h1 {
        margin: 0 0 1.5rem 0;
    }
    .content-container {
        display: flex;
        width: 100%;
        flex-direction: column;
    }
    .text-right {
        text-align: right;
    }
    .align-self-end {
        margin-left: auto;
        margin-top: 60px;
    }
    .m-w-700 {
        max-width: min(700px, 100%);
    }
    .tags-container {
        display: flex;
        margin: 50px 0;
        .tags-list {
            margin-left: auto;
            text-align: right;
            .tags-list-item {
                list-style: none;
                font-weight: lighter;
                font-size: 32px;
                transition: color 0.8s;
                cursor: default;
            }
            .tags-list-item:hover {
                color: #ffc8fd;
            }
        }
    }

    .hero-image {
        margin: auto clamp(15px, 12vw, 180px);
    }
    .hero-image img {
        display: block;
        border-radius: 5px;
        max-width: 100%;
        height: auto;
    }
    .prose {
        width: 720px;
        max-width: calc(100% - 2em);
        margin: auto;
        padding: 1em;
        color: #594a4e;
    }

    .title {
        margin-bottom: 1em;
        padding: 1em 0;
        text-align: center;
        line-height: 1;
    }
    .title h1 {
        margin: 0 0 0.5em 0;
    }
    .date {
        margin-bottom: 0.5em;
        color: rgb(var(--gray));
    }
    .last-updated-on {
        font-style: italic;
    }

    /* ---------- Full-bleed hero ---------- */
    .hero-bleed {
        width: 100vw;
        margin-left: calc(50% - 50vw);
        margin-right: calc(50% - 50vw);
    }
    .hero-bleed img {
        display: block;
        width: 100%;
        height: auto;
    }

    /* ---------- Breakpoints (fine-tuning below what clamp() already covers) ---------- */
    @media (max-width: 720px) {
        .tags-container {
            margin: 25px 0;
            .tags-list {
                .tags-list-item {
                    font-size: 16px;
                }
            }
        }
    }
    @media (max-width: 780px) {
        .content-container {
            gap: 24px;
        }
        .text-right {
            text-align: left;
        }
        .align-self-end {
            margin-left: 0;
            margin-top: 24px;
        }
        .centered-project-content {
            margin: auto 15px;
        }
    }
    @media (max-width: 480px) {
        .section-nav-link {
            padding: 4px 8px;
        }
        .project-title--container {
            margin: 24px 15px 32px;
        }
    }
</style>
